    <VCProjectVersion>18.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{1CB67BEE-DA37-5D52-A875-FABECCCD5014}</ProjectGuid>
    <RootNamespace>lt</RootNamespace>
  </PropertyGroup>
