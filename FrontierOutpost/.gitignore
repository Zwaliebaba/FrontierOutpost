# Build output (Directory.Build.props): bin\<Platform>\<Configuration>\ and
# obj\<Platform>\<Configuration>\<Project>\, both at this folder's root.
/bin/
/obj/

# Visual Studio state and per-user files.
.vs/
*.user
*.suo
*.rsuser

# The root .gitignore ignores every directory named Win32, x64, x86, bin or ARM64. That is right
# for build output and wrong for these vendored binaries: it is how ltheory-old-main/ silently lost
# extlib/win32 and extbin/win32 (MIGRATION_NOTES.md §4). extlib/x64 and extbin/x64 receive the
# owner's FMOD Ex x64 files (MIGRATION_NOTES.md D8).
!/extlib/win32/
!/extbin/win32/
!/extlib/x64/
!/extbin/x64/
!/ext/SFML/extlibs/bin/
!/ext/SFML/extlibs/bin/x64/
!/ext/SFML/extlibs/bin/x86/
!/ext/SFML/extlibs/libs-msvc-universal/x64/
!/ext/SFML/extlibs/libs-msvc-universal/x86/
# SFML's own Windows implementation lives in src/SFML/<Module>/Win32/, which the same rule drops.
!/ext/SFML/src/SFML/*/Win32/
