  <!-- CompiledShaders/ is build output (AGENTS.md §2), made on every build before FXC writes to it. -->
  <Target Name="MakeCompiledShadersFolder" BeforeTargets="FxCompile">
    <MakeDir Directories="$(ProjectDir)CompiledShaders" />
  </Target>
  <!-- WinPixEventRuntime must be restored before the build (Design/ADR/ADR-018). -->
  <Target Name="RequireWinPixEventRuntime" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(WinPixEventRuntimeDir)bin\$(Platform)\WinPixEventRuntime.lib')" Text="WinPixEventRuntime is not restored. Run: msbuild FrontierOutpost.slnx -t:restore -p:RestorePackagesConfig=true" />
  </Target>
  <!-- Its DLL goes to the output folder that the executable and the test suites share, since both
       load it at startup (Design/ADR/ADR-018). -->
  <Target Name="CopyWinPixEventRuntime" AfterTargets="Build">
    <Copy SourceFiles="$(WinPixEventRuntimeDir)bin\$(Platform)\WinPixEventRuntime.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
