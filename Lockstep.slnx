<Solution>
  <!--
    x64 is the only platform this game supports (AGENTS.md 3). Win32/x86 was removed
    on 2026-09-09 together with the Win32 configurations in every .vcxproj: nothing
    in a 640x400 D3D12 client wants a 32-bit address space, and a second platform
    nobody builds is a second platform nobody notices breaking.
  -->
  <Configurations>
    <Platform Name="x64" />
  </Configurations>
