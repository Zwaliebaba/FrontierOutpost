type HUDApp
  Object system
  Player player
  Float t 0
  Texture texture Texture/RandomScreenshot:Get

  function List CreateChildren (Widget self)
    var l List
    l += (Widget/HUD:Create player)
    l

  function Void PreDraw (Widget self)
    Draw texture self.pos self.size 1.0

function Data Main ()
  var self HUDApp
  # A system taken from Object_Universe is empty until it is initialised, so
  # the system is made and filled as the map app does it. Its players are AI
  # pilots, and station managers own no ship: the HUD shows a pilot's.
  self.system = (Object_System (Vec3 15.012) 42)
  Object/System:Init self.system

  for it self.system.GetInteriorObjects it.HasMore it.Advance
    if it.Get.GetOwner.IsNotNull
      if it.Get.GetOwner.GetPiloting.IsNotNull
        self.player = it.Get.GetOwner

  var ship self.player.GetPiloting
  for i 0 i < 10 (++ i)
    ship.AddItem (Item_WeaponType i + 100) 1

  widget:Create
    Layer
      Compositor_None
      Mesh_Quad
      1.0
      Stack
        Custom Widget self
