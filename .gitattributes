# Text: normalise to LF in the index AND the working copy, regardless of
# core.autocrlf. rustfmt, Prettier and the Blender scripts all expect LF.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets are committed to Git as they are: they are small (a few MB in all). `binary`
# keeps line-ending normalisation and text diffs away from them. Add new binary types here.
# Blender sources and exported scenes
*.blend binary
*.glb   binary
*.fbx   binary
# Images and textures
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ktx2  binary
*.hdr   binary
*.exr   binary
*.psd   binary
# Audio
*.wav   binary
*.ogg   binary
*.mp3   binary
# Fonts
*.ttf   binary
*.otf   binary
*.woff2 binary
