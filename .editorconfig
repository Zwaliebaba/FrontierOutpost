root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{rs,py,toml}]
indent_size = 4

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

# Generated by ts-rs; leave exactly as produced.
[client/src/protocol/generated/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
