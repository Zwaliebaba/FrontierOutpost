{
  "name": "frontier-outpost-client",
  "version": "0.1.0",
  "private": true,
  "description": "Frontier Outpost HTML5 client (TypeScript + Three.js).",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build:sim": "cargo build --locked --release -p frontier-sim-wasm --target wasm32-unknown-unknown && wasm-bindgen --target web --out-dir src/sim/pkg ../target/wasm32-unknown-unknown/release/frontier_sim_wasm.wasm",
    "predev": "npm run build:sim",
    "dev": "vite",
    "prebuild": "npm run build:sim",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run build:sim && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "e2e": "playwright test",
    "e2e:container": "playwright test --config playwright.container.config.ts"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
